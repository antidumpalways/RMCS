// R CELL Management System - Prisma Schema
// Filosofi: 1 modul Inventory generik, kategori = data, bukan logic terpisah.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// SETTINGS - data dasar toko (singleton, id=1)
// ============================================================================
model Settings {
  id          Int      @id @default(1)
  storeName   String   @default("R CELL")
  cashInitial BigInt   @default(0) // Cash Awal (rupiah)
  balanceInitial BigInt @default(0) // Saldo Awal (e-wallet/transfer)
  theme       String   @default("system") // light | dark | system
  updatedAt   DateTime @updatedAt
}

// ============================================================================
// LOCATIONS - lokasi penyimpanan barang (custom, admin kelola)
// ============================================================================
model Location {
  id        Int      @id @default(autoincrement())
  name      String   @unique // "Rak 1", "Toples Samping", "Gudang", dll
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  products Product[]

  @@index([sortOrder])
}

// ============================================================================
// USERS - owner (1) + karyawan (banyak, bisa juga per-shift)
// "owner" = lihat semua, "karyawan" = angka sensitif di-XXXX
// Username bisa encode shift: "shift1", "shift2", "admin", "karyawan"
// ============================================================================
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  pin       String   // PIN 4-6 digit
  role      String   @default("karyawan") // "owner" | "karyawan"
  shift     String?  // opsional: "siang" | "malam" (atau bebas)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  saleTransactions    SaleTransaction[]
  serviceTransactions ServiceTransaction[]
  expenses            Expense[]
  inventoryMovements  InventoryMovement[]
  debts               Debt[]
  debtPayments        DebtPayment[]
  shiftClosures       ShiftClosure[]
  stockOpnames        StockOpname[]
  reviewedStockOpnames StockOpname[] @relation("StockOpnameReviewer")
  assistantFeedback AssistantFeedback[] @relation("AssistantFeedbackAuthor")
  reviewedAssistantFeedback AssistantFeedback[] @relation("AssistantFeedbackReviewer")
  assistantMemories AssistantMemory[] @relation("AssistantMemoryAuthor")
  telegramSessions TelegramSession[]
  telegramDrafts TelegramDraft[]
  telegramShiftReports TelegramShiftReport[]
  telegramCorrectionsRequested TelegramReportCorrection[] @relation("TelegramCorrectionRequester")
  telegramCorrectionsApproved TelegramReportCorrection[] @relation("TelegramCorrectionApprover")
  linkedTelegramIdentity TelegramIdentity? @relation("LinkedTelegramUser")
  telegramUserId BigInt? @unique
  telegramLinkCodeHash String? @unique
  telegramLinkExpiresAt DateTime?
}

// ============================================================================
// CATEGORIES - master kategori (Accessories, Voucher, Pulsa, Rokok, dll)
// ============================================================================
model Category {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  subcategories Subcategory[]
  products      Product[]
}

// ============================================================================
// SUBCATEGORIES - subkategori per kategori (Tempered Glass, Hydrogel, dll)
// ============================================================================
model Subcategory {
  id         Int       @id @default(autoincrement())
  name       String
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

// ============================================================================
// PRODUCTS - barang dagangan
// profit SELALU dihitung = sellPrice - costPrice, tidak disimpan.
// ============================================================================
model Product {
  id            Int       @id @default(autoincrement())
  name          String
  sku           String?   @unique
  categoryId    Int
  category      Category  @relation(fields: [categoryId], references: [id])
  subcategoryId Int?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id])
  provider      String?  // opsional: Telkomsel, XL, Axis, Three, Smartfren, By.U, IM3, dll
  validity      String?  // opsional: "3 hari", "5 hari", "7 hari", "Standard", dll
  locationId    Int?
  location      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  costPrice     BigInt    @default(0) // Modal
  sellPrice     BigInt    @default(0) // Harga Jual
  stock         Int       @default(0) // Stok Saat Ini
  minStock      Int       @default(3) // Minimal Stok (alert)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]
  stockOpnames       StockOpname[]
  assistantFeedback  AssistantFeedback[]
  telegramInventoryPostings TelegramInventoryPosting[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([name])
  @@index([provider])
  @@index([locationId])
}

// Umpan balik eksplisit, bukan perubahan otomatis pada fakta katalog.
// Hanya alias yang disetujui owner dipakai untuk pencarian berikutnya.
model AssistantFeedback {
  id              Int      @id @default(autoincrement())
  query           String
  queryKey        String
  productId       Int?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  note            String?
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED | REVOKED
  userId          Int
  user            User     @relation("AssistantFeedbackAuthor", fields: [userId], references: [id])
  reviewedById    Int?
  reviewedBy      User?    @relation("AssistantFeedbackReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([status, createdAt])
  @@index([queryKey, status])
  @@index([createdAt])
}

// Analitik pencarian tanpa riwayat percakapan, identitas pengguna, atau foto.
model AssistantSearchEvent {
  id          Int      @id @default(autoincrement())
  queryKey    String
  resultCount Int
  createdAt   DateTime @default(now())

  @@index([queryKey, createdAt])
  @@index([createdAt])
}

// Memori asisten yang disimpan sadar oleh owner agar asisten "belajar":
// istilah khas toko, cara bicara/sapaan, dan preferensi/aturan toko.
model AssistantMemory {
  id          Int      @id @default(autoincrement())
  kind        String   // SYNONYM | STYLE | PREFERENCE
  term        String?  // istilah/istilah yang dipakai (terutama SYNONYM)
  content     String   // penjelasan/makna/aturan
  active      Boolean  @default(true)
  createdById Int?
  createdBy   User?    @relation("AssistantMemoryAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, active])
  @@index([createdAt])
}

// ============================================================================
// INVENTORY MOVEMENTS - pencatatan barang masuk (stok bertambah)
// Setiap kali barang masuk, modal di-update ke harga beli terbaru.
// ============================================================================
model InventoryMovement {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        String   // "IN" (barang masuk) - diserderhanakan, hanya IN untuk v1
  qty         Int
  costAtTime  BigInt   // harga beli per unit SAAT itu (untuk histori & update modal)
  supplier    String?  // opsional: nama supplier
  note        String?
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  telegramIdentityId String?
  telegramIdentity TelegramIdentity? @relation("TelegramInventoryActor", fields: [telegramIdentityId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  telegramPosting TelegramInventoryPosting?
  telegramCorrection TelegramReportCorrection?

  @@index([productId])
  @@index([createdAt])
}

// ============================================================================
// DEBTS / PIUTANG - customer bon
// Karyawan boleh lihat & tambah. Owner bisa edit & tandai lunas.
// ============================================================================
model Debt {
  id          Int      @id @default(autoincrement())
  customer    String   // nama customer
  amount      BigInt   // total hutang
  paid        BigInt   @default(0) // sudah dibayar
  description String?  // opsional: "Beli 2 case iPhone"
  status      String   @default("BELUM") // BELUM | LUNAS
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments    DebtPayment[]

  @@index([createdAt])
  @@index([status])
}

model DebtPayment {
  id        Int      @id @default(autoincrement())
  debtId    Int
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount    BigInt   // nominal cicilan
  note      String?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([debtId])
  @@index([createdAt])
}

// ============================================================================
// SHIFT CLOSURES - end-of-shift snapshot
// Setiap kali karyawan "tutup shift", sistem catat ringkasan
// ============================================================================
model ShiftClosure {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  shift         String   // "siang" | "malam" (dari user.shift)
  closedAt      DateTime @default(now())
  salesCount    Int      @default(0)
  salesRevenue  BigInt   @default(0)
  salesProfit   BigInt   @default(0)
  servicesCount Int      @default(0)
  servicesProfit BigInt  @default(0)
  expensesTotal BigInt   @default(0)
  openingCash   BigInt   @default(0) // kas seharusnya di awal shift
  cashIn        BigInt   @default(0) // uang masuk selama shift (penjualan + jasa + bon)
  cashOut       BigInt   @default(0) // uang keluar selama shift (pengeluaran)
  expectedCash  BigInt   @default(0) // openingCash + cashIn - cashOut
  actualCash    BigInt?  // kas fisik hasil hitung karyawan
  cashDifference BigInt? // actualCash - expectedCash
  openingStockCount Int  @default(0)
  closingStockCount Int  @default(0)
  stockDiscrepancyCount Int @default(0)
  note          String?
  telegramDraftId String? @unique

  @@index([closedAt])
  @@index([userId])
  @@index([shift])
}

// Durable Telegram bot state; update IDs and shift draft IDs provide idempotency.
model TelegramUpdate {
  updateId   BigInt   @id
  status     String   @default("PROCESSING") // PROCESSING | PROCESSED | FAILED
  attempts   Int      @default(1)
  leaseUntil DateTime?
  processedAt DateTime?
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, leaseUntil])
}

// Telegram-native identities stay isolated from RMCS web-login accounts.
model TelegramIdentity {
  id                    String   @id @default(cuid())
  telegramUserId        BigInt   @unique
  displayName           String
  username              String?
  lastGroupId           BigInt
  linkedUserId          Int?     @unique
  linkedUser            User?    @relation("LinkedTelegramUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  sessions              TelegramSession[]
  drafts                TelegramDraft[]
  shiftReports          TelegramShiftReport[]
  requestedCorrections  TelegramReportCorrection[] @relation("TelegramCorrectionTelegramRequester")
  approvedCorrections   TelegramReportCorrection[] @relation("TelegramCorrectionTelegramApprover")
  inventoryMovements    InventoryMovement[] @relation("TelegramInventoryActor")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([lastGroupId])
}

model TelegramSession {
  id        String   @id @default(cuid())
  chatId    BigInt
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  telegramIdentityId String?
  telegramIdentity TelegramIdentity? @relation(fields: [telegramIdentityId], references: [id], onDelete: Cascade)
  state     String   // REPORTING | WAITING_CONFIRMATION
  revision  Int      @default(0)
  draftId   String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chatId, userId])
  @@unique([chatId, telegramIdentityId])
  @@index([userId, expiresAt])
}

model TelegramDraft {
  id          String   @id @default(cuid())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  telegramIdentityId String?
  telegramIdentity TelegramIdentity? @relation(fields: [telegramIdentityId], references: [id], onDelete: SetNull)
  chatId      BigInt
  kind        String   // SHIFT_RECAP
  payload     Json
  status      String   @default("PENDING") // PENDING | PROCESSING | CONFIRMED | CANCELLED | EXPIRED | FAILED
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status, expiresAt])
  @@index([telegramIdentityId, status, expiresAt])
  @@index([chatId, status])
  shiftReport TelegramShiftReport?
}

model TelegramShiftReport {
  id          String   @id @default(cuid())
  draftId     String   @unique
  draft       TelegramDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  telegramIdentityId String?
  telegramIdentity TelegramIdentity? @relation(fields: [telegramIdentityId], references: [id], onDelete: SetNull)
  chatId      BigInt
  shiftLabel  String?
  payload     Json
  confirmedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, confirmedAt])
  @@index([telegramIdentityId, confirmedAt])
  @@index([chatId, confirmedAt])
  inventoryPostings TelegramInventoryPosting[]
  corrections TelegramReportCorrection[]
}
// ============================================================================
// STOCK OPNAME - audit stok
// Owner input "stok fisik seharusnya X" → sistem hitung selisih vs Product.stock
// ============================================================================
model StockOpname {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  systemStock Int    // stok di sistem saat opname
  physicalStock Int  // hasil hitung fisik
  diff      Int      // physical - system (negatif = kurang, positif = lebih)
  reviewStatus String @default("PENDING") // PENDING | REVIEWED | APPLIED | MATCHED
  reviewedAt DateTime?
  note      String?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  reviewedByUserId Int?
  reviewedBy User? @relation("StockOpnameReviewer", fields: [reviewedByUserId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

// ============================================================================
// SALE TRANSACTIONS - header penjualan
// ============================================================================
model SaleTransaction {
  id        Int        @id @default(autoincrement())
  kind      String     @default("SALE") // SALE | RETURN (retur mengurangi omzet & kas)
  totalRevenue BigInt  @default(0) // Omzet (sum sellPrice * qty)
  totalProfit  BigInt  @default(0) // Profit (sum (sellPrice-costPrice) * qty)
  returnOfId   Int?
  returnOf     SaleTransaction?  @relation("SaleReturns", fields: [returnOfId], references: [id], onDelete: SetNull)
  returns      SaleTransaction[] @relation("SaleReturns")
  userId       Int?
  user         User?     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  items        SaleItem[]

  @@index([createdAt])
  @@index([userId])
  @@index([returnOfId])
}

model SaleItem {
  id        Int      @id @default(autoincrement())
  saleId    Int
  sale      SaleTransaction @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  qty       Int
  priceAtSale BigInt // harga jual saat transaksi
  costAtSale BigInt // modal saat transaksi (snapshot)
  revenue   BigInt  // priceAtSale * qty
  profit    BigInt  // (priceAtSale - costAtSale) * qty

  @@index([saleId])
  @@index([productId])
}

// ============================================================================
// BIAYA ADMIN - rekap jasa harian (top up, transfer, tarik tunai, dll)
// User input: jumlah transaksi + total admin. Profit = total admin (otomatis).
// ============================================================================
model ServiceTransaction {
  id        Int      @id @default(autoincrement())
  count     Int      // jumlah transaksi
  profit    BigInt   // total admin (otomatis = profit)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// ============================================================================
// EXPENSES - pengeluaran (otomatis kurangi cash saat dicatat)
// ============================================================================
model Expense {
  id        Int      @id @default(autoincrement())
  name      String
  amount    BigInt
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// Auditable aggregate recap stock deductions; never creates SaleTransaction rows.
model TelegramInventoryPosting {
  id             String   @id @default(cuid())
  operationKey   String   @unique
  reportId       String
  report         TelegramShiftReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  lineId         String
  productId      Int
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceText     String
  productLabel   String
  reportedQty    Int
  webAppQty      Int      @default(0)
  coverage       String   @default("UNRECORDED_ONLY")
  appliedQty     Int
  movementId     Int?     @unique
  movement       InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  corrections    TelegramReportCorrection[]

  @@unique([reportId, lineId])
  @@index([productId, createdAt])
}

// Corrections preserve the original recap and apply an idempotent compensating movement after owner approval.
model TelegramReportCorrection {
  id             String   @id @default(cuid())
  operationKey   String   @unique
  reportId       String
  report         TelegramShiftReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  postingId      String
  posting         TelegramInventoryPosting @relation(fields: [postingId], references: [id], onDelete: Restrict)
  requestedById  Int?
  requestedBy    User? @relation("TelegramCorrectionRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedByTelegramIdentityId String?
  requestedByTelegramIdentity TelegramIdentity? @relation("TelegramCorrectionTelegramRequester", fields: [requestedByTelegramIdentityId], references: [id], onDelete: SetNull)
  approvedById   Int?
  approvedBy     User? @relation("TelegramCorrectionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedByTelegramIdentityId String?
  approvedByTelegramIdentity TelegramIdentity? @relation("TelegramCorrectionTelegramApprover", fields: [approvedByTelegramIdentityId], references: [id], onDelete: SetNull)
  reason         String
  previousQty    Int
  requestedQty   Int
  deltaQty       Int
  status         String   @default("PENDING")
  movementId     Int?     @unique
  movement       InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  approvedAt     DateTime?

  @@index([reportId, createdAt])
  @@index([status, createdAt])
}
