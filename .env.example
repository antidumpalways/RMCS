# ==============================================
# R CELL Management System - Environment Template
# ==============================================
# Copy file ini ke .env untuk development local,
# atau set di Vercel Dashboard untuk production.
# ==============================================

# ----- Database (PostgreSQL) -----
# Dapatkan dari Neon: https://neon.tech → buat project → copy connection string
# Format: postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxxx.us-east-1.aws.neon.tech/rcms?sslmode=require"

# ----- DeepSeek AI Assistant -----
# Buat API key dari DeepSeek Platform, lalu simpan sebagai secret di Vercel.
DEEPSEEK_API_KEY="your-deepseek-api-key"
# Opsional; default: deepseek-flash
DEEPSEEK_MODEL="deepseek-flash"
# Opsional; model DeepSeek yang dapat membaca foto. Default: deepseek-flash.
DEEPSEEK_VISION_MODEL="deepseek-flash"

# ----- Optional -----
# NODE_ENV akan di-set otomatis oleh Vercel
# (production saat deploy, development saat npm run dev)
TELEGRAM_BOT_TOKEN=""
# Telegram setWebhook secret_token; 1-256 chars from A-Z, a-z, 0-9, underscore, or hyphen.
TELEGRAM_WEBHOOK_SECRET=""
# Comma-separated numeric Telegram group/supergroup chat IDs, e.g. -1001234567890
TELEGRAM_ALLOWED_GROUP_IDS=""
